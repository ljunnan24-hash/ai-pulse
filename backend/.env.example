# MySQL (RDS)
# 新库：执行仓库根目录 sql/schema.sql。已有库：按需执行 sql/migrations/*.sql（见 docs/部署与数据说明.md）
# 账号名以控制台为准（示例为 aipulse1）；库名默认 aipulse
DATABASE_URL=mysql+pymysql://aipulse1:PASSWORD@rm-xxxx.mysql.rds.aliyuncs.com:3306/aipulse?charset=utf8mb4
# RDS 开启 SSL、且 MySQL 要求加密连接时：填写 PEM 路径（与 mysql --ssl-ca 相同）；不设则不校验证书
# DATABASE_SSL_CA=/ssl/ApsaraDB-CA-Chain.pem

# Public URL of this API (used in confirmation links in emails)
PUBLIC_APP_URL=https://api.yourdomain.com

# English marketing site (redirects after confirm / unsubscribe / manage)
FRONTEND_URL=https://www.yourdomain.com

# Volcengine Ark — model endpoint ID from console
DOUBAO_API_KEY=
DOUBAO_API_BASE=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=ep-xxxx
# Multi-agent：默认开启。若要改为单次豆包 summarize：MULTI_AGENT_WEEKLY=false
# MULTI_AGENT_DIGEST_TOP_N=20
# 可选：Editor 润色、Auditor 高危回退
# MULTI_AGENT_ENABLE_EDITOR=false
# MULTI_AGENT_ENABLE_AUDITOR=false

# Aliyun DirectMail SMTP
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=AI Pulse <noreply@yourdomain.com>
# 测试周刊：只向该邮箱发 send_weekly（须与 subscribers 里已确认活跃用户邮箱一致）；生产勿配或留空
# TARGET_EMAIL=your-test@example.com

# RSS sources (comma-separated) — 无内置默认，须显式配置（见根目录 prd.md 第五节）
# Official sites RSS (P0)
# OFFICIAL_RSS_URLS=
# Media RSS (P1)
# MEDIA_RSS_URLS=
# Community RSS: HN / Reddit 等 (P3，可选)
# COMMUNITY_RSS_URLS=
# X/Twitter RSS 桥接 (P4，可选)
# X_RSS_URLS=
# Meta AI Blog 等官方桥 (P0)
# META_RSS_URLS=
# Product Hunt 等新产品 RSS（tier 与名称含 product）
# PRODUCT_RSS_URLS=
# 官网文章列表 HTML：爬取页内 <link rel="alternate" … rss|atom>，再拉 RSS（无链则跳过）
# OFFICIAL_PAGE_URLS=
# 采集顺序（可含 github）：缺省见 app/config.py 的 crawl_priority
# CRAWL_PRIORITY=official,meta,media,product,community,x,github

# GitHub：Trending 页面（优先）+ Search API 回退
# Token 未设置时限流更低，cron 下建议配置。
GITHUB_TOKEN=
# Search API：仓库创建时间窗口（天），与 PRD 约 180 天一致
GITHUB_SEARCH_CREATED_WITHIN_DAYS=180
# Search API：最低 star 数；若 GITHUB_TRENDING_MIN_STARS_GROWTH 更大则取更高下限（见 app/config.py）
GITHUB_SEARCH_MIN_STARS=500
# 周榜与 Search 路径是否按 AI 关键词过滤标题/描述（默认 true）
# GITHUB_AI_KEYWORD_FILTER=true
# 兼容旧名：stars 下限抬高（可与 GITHUB_SEARCH_MIN_STARS 取 max）
# GITHUB_TRENDING_MIN_STARS_GROWTH=500
# Optional language filter, e.g. Python / TypeScript
GITHUB_TRENDING_LANGUAGE=

# If true, email jobs log only and do not send real mail
MAIL_DRY_RUN=false

# Admin API (/admin/*) — set strong random values in production
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRES_HOURS=24
# CORS: admin SPA origin (e.g. https://admin.aipulse.asia)
ADMIN_FRONTEND_URL=
