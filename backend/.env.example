# MySQL (RDS)
# 新库：执行仓库根目录 sql/schema.sql。已有库：按需执行 sql/migrations/*.sql（见 docs/部署与数据说明.md）
DATABASE_URL=mysql+pymysql://USER:PASSWORD@rm-xxxx.mysql.rds.aliyuncs.com:3306/aipulse?charset=utf8mb4

# Public URL of this API (used in confirmation links in emails)
PUBLIC_APP_URL=https://api.yourdomain.com

# English marketing site (redirects after confirm / unsubscribe / manage)
FRONTEND_URL=https://www.yourdomain.com

# 对外周报页根 URL（邮件 main_link = {WEEKLY_PUBLIC_BASE_URL}/weekly/YYYY-MM-DD）
WEEKLY_PUBLIC_BASE_URL=https://aipulse.asia

# Volcengine Ark — model endpoint ID from console
DOUBAO_API_KEY=
DOUBAO_API_BASE=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=ep-xxxx
# Composer 等大 JSON；过小易截断导致 JSON 解析失败（可按方舟控制台模型上限调整）
# DOUBAO_MAX_TOKENS=16384

# Phase 2.5 排行榜 Insight Agent（关闭或未配置豆包时 daily_rankings 照常跑，仅跳过 LLM）
# RANKING_INSIGHT_ENABLED=false
# RANKING_INSIGHT_LIMIT=30
# RANKING_INSIGHT_BATCH_SIZE=8

# Phase 3：周报选题来源 — legacy=RSS+issue_events；global_events=过去 N 天 global_events（需已跑 daily_rankings）
# WEEKLY_SOURCE=legacy
# GLOBAL_EVENTS_LOOKBACK_DAYS=7
# GLOBAL_EVENTS_MIN_CANDIDATES=8
# GLOBAL_EVENTS_FALLBACK_LOOKBACK_DAYS=14
# GLOBAL_EVENTS_POOL_LIMIT=40

# 强制重跑本期 generate_weekly（与 --force 等价，不改 period_start）
# GENERATE_WEEKLY_FORCE=1
# 不重爬：沿用本期已入库 raw_items / issue_events，只重做生成（与 --reuse-crawl 等价）
# GENERATE_WEEKLY_REUSE_CRAWL=1

# Multi-agent weekly（build_weekly_multi_agent）
# MULTI_AGENT_ENABLE_EDITOR=false
# MULTI_AGENT_ENABLE_AUDITOR=false
# Email Deliverability Auditor + Rewriter（默认开启；关闭则 MULTI_AGENT_ENABLE_DELIVERABILITY=false）
# MULTI_AGENT_DELIVERABILITY_REWRITE_BELOW=85
# MULTI_AGENT_DELIVERABILITY_MIN_SCORE=70
# MULTI_AGENT_DELIVERABILITY_STRICT=true

# Aliyun DirectMail SMTP
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=AI Pulse <noreply@yourdomain.com>

# RSS sources (comma-separated) — 无代码内置默认，须显式配置（见 prd.md 第五节）
# Official sites RSS (P0)
# OFFICIAL_RSS_URLS=
# Media RSS (P1)
# MEDIA_RSS_URLS=
# Community RSS: HN/Reddit 等 (P3, optional)
# COMMUNITY_RSS_URLS=
# X/Twitter RSS 桥接 (P4, optional)
# X_RSS_URLS=
# Meta AI Blog 等 (P0 官方桥)
# META_RSS_URLS=

# 国内大模型官方：多数无稳定公开 RSS，可用 OFFICIAL_PAGE_URLS 写官网/产品/新闻列表页，由爬虫发现 <link rel="alternate">。
# 详见 docs/国内大模型官方信源.md。若有 RSSHub 自建实例，可把生成的 RSS URL 放进 OFFICIAL_RSS_URLS 或 X_RSS_URLS。
# OFFICIAL_PAGE_URLS=https://www.deepseek.com/,https://tongyi.aliyun.com/,https://ai.baidu.com/tech,...

# --- RSS 源治理（详见 docs/rss源治理记录.md；勿自动改生产 .env）---
# 下列 URL 建议从 OFFICIAL_RSS_URLS / MEDIA_RSS_URLS 的逗号列表中移除（稳定坏链 / 非 RSS / 404/403）：
# https://www.jiqizhixin.com/rss
# https://alignment.anthropic.com/feed.xml
# https://blog.langchain.com/rss/
# https://nvidianews.nvidia.com/rss
# https://blogs.nvidia.com/blog/feed/
# https://stability.ai/news?format=rss
# https://txt.cohere.ai/rss/
# https://mistral.ai/news/feed.xml
# https://www.anthropic.com/news/rss.xml
# https://www.anthropic.com/research/rss.xml
# https://www.databricks.com/blog/rss.xml
# https://www.llamaindex.ai/blog/rss.xml
# https://www.perplexity.ai/hub/blog/rss.xml
#
# 下列 NVIDIA 候选已通过 scripts/verify_feeds_stdlib.py --nvidia-defaults（HTTP 2xx + rss+xml + item）可追加到 OFFICIAL_RSS_URLS：
# https://nvidianews.nvidia.com/releases.xml
# https://nvidianews.nvidia.com/cats/generative_al.xml
# https://feeds.feedburner.com/nvidiablog
#
# 汇总分类：cd backend && python scripts/rss_source_governance.py

# GitHub: Trending 页（优先）+ Search API 回退
GITHUB_TOKEN=
# Search API：仓库创建时间窗口（天），与 PRD 约 180 天一致
GITHUB_SEARCH_CREATED_WITHIN_DAYS=180
# Search API：最低 star 数（与 GITHUB_TRENDING_MIN_STARS_GROWTH 取 max 见 config 说明）
GITHUB_SEARCH_MIN_STARS=500
# 仅保留标题/描述命中 AI 关键词的仓库（周榜与 Search 均适用）
# GITHUB_AI_KEYWORD_FILTER=true
# 兼容旧名：若该值高于 GITHUB_SEARCH_MIN_STARS，会抬高 Search 的 stars 下限
# GITHUB_TRENDING_MIN_STARS_GROWTH=500
# Optional language filter, e.g. Python / TypeScript
GITHUB_TRENDING_LANGUAGE=

# If true, email jobs log only and do not send real mail
MAIL_DRY_RUN=false

# 周刊测试推荐：命令行 `python -m app.jobs.send_weekly --test`（只发 WEEKLY_TEST_INBOX），不必改下面开关
# 可选：远程仅用环境变量限制收件人（一般不必）
# WEEKLY_SEND_TEST_MODE=false
# WEEKLY_TEST_INBOX=2089128910@qq.com
# TARGET_EMAIL=

# Admin API (/admin/*) — set strong random values in production
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRES_HOURS=24
# CORS: admin SPA origin (e.g. https://admin.aipulse.asia)
ADMIN_FRONTEND_URL=
