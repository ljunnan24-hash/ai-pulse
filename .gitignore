~$*.doc*

# Canonical PRD is `prd.md` only — ignore exported Word copies (e.g. *prd.docx)
*prd.docx

# Local scratch / extraction artifacts
._docx_extract/

# Do not commit local copies of RDS CA material (e.g. ApsaraDB-Chain)
ssl/
