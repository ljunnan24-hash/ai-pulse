# AI Pulse — example crontab
#
# 【时区 — 统一上海时间】
# 必须保留 TZ= 一行：其后的每一条「分 时 日 月 周」定时任务，均按该时区解析（上海 = Asia/Shanghai）。
# TZ=Asia/Shanghai = 中国东部时间（上海），与「北京时间」同一时刻（UTC+8）。
# 若服务器系统时区已是 Asia/Shanghai，仍建议保留本行，避免与 crontab 其它条目冲突。
# 亦可执行：timedatectl set-timezone Asia/Shanghai
#
# flock：同一任务不重叠；日志路径请按部署修改。
# 深夜跑重任务，减轻白天访问高峰 CPU / IO。

TZ=Asia/Shanghai

# flock 锁文件可用 /tmp（兼容性好）或 /var/lock（部分发行版需权限）；-n 表示拿不到锁则跳过本次，防并发写库。
#
# 02:10 — 每日爬虫 + raw_items + global_events / 排行榜
10 2 * * * cd /opt/ai-pulse/backend && flock -n /tmp/aipulse_daily_rankings.lock /opt/ai-pulse/backend/.venv/bin/python -m app.jobs.daily_rankings >> /var/log/aipulse-daily.log 2>&1

# 02:40 — Ranking Insight 文案 enrich（依赖 .env RANKING_INSIGHT_ENABLED；可按需注释）
40 2 * * * cd /opt/ai-pulse/backend && flock -n /tmp/aipulse_enrich_rankings.lock /opt/ai-pulse/backend/.venv/bin/python -m app.jobs.enrich_rankings --limit 80 >> /var/log/aipulse-enrich.log 2>&1

# 周一 04:10 — 周报生成（generate_weekly；晚于每日 02:10 日报，避免数据未就绪）
10 4 * * 1 cd /opt/ai-pulse/backend && flock -n /tmp/aipulse_generate_weekly.lock /opt/ai-pulse/backend/.venv/bin/python -m app.jobs.generate_weekly >> /var/log/aipulse-generate.log 2>&1

# 周一 05:00 — 向订阅用户发送周报邮件（须晚于上一行生成任务）
0 5 * * 1 cd /opt/ai-pulse/backend && flock -n /tmp/aipulse_send_weekly.lock /opt/ai-pulse/backend/.venv/bin/python -m app.jobs.send_weekly >> /var/log/aipulse-send.log 2>&1

# FastAPI 建议 systemd / supervisor，例如：
#   uvicorn app.main:app --host 0.0.0.0 --port 8000
