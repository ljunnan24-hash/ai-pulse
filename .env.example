# Dev: leave empty to use Vite proxy to FastAPI on :8000
# Prod: set to your API origin, e.g. https://api.example.com
VITE_API_BASE_URL=

# Public contact shown on About / Terms / Privacy pages.
VITE_CONTACT_EMAIL=contact@example.com

# Public site origin used for canonical URLs and structured data.
VITE_SITE_URL=https://www.aipulse.asia

# Optional public assets. Leave empty for open-source defaults; set to hosted image paths in your deployment.
# VITE_WECHAT_GROUP_QR_SRC=/assets/wechat-group-qr.example.png
# VITE_REWARD_QR_SRC=/assets/reward-qr.example.png
